import pandas as pd
from lifelines import CoxPHFitter

df = pd.read_csv("data/raw/day_approach_maskedID_timeseries.csv")

training_load_cols = [c for c in df.columns if 'RPE' in c or 'distance' in c]
df['avg_load'] = df[training_load_cols].mean(axis=1)

cph = CoxPHFitter()
cph.fit(df[['avg_load', 'days_observed', 'injured']],
        duration_col='days_observed', event_col='injured')

#baseline
#
cph.print_summary()
